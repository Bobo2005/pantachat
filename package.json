{
  "name": "pantachat",
  "version": "1.0.0",
  "description": "Conversational prediction market bot for Telegram and Discord on Solana, powered by the Panta API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "test:db": "tsx scripts/test_prompt2_db.ts",
    "test:client": "tsx scripts/test_prompt3_client.ts",
    "test:markets": "tsx scripts/test_prompt4_markets.ts",
    "test:drafter": "tsx scripts/test_prompt5_drafter.ts",
    "test:create": "tsx scripts/test_prompt6_create.ts",
    "test:trading": "tsx scripts/test_prompt7_trading.ts",
    "test:attribution": "tsx scripts/test_prompt8_attribution.ts",
    "test:lifecycle": "tsx scripts/test_prompt9_lifecycle.ts",
    "test:royalties": "tsx scripts/test_prompt10_royalties.ts",
    "test:cards": "tsx scripts/test_prompt11_cards.ts",
    "test:telegram": "tsx scripts/test_prompt12_telegram.ts",
    "test:callbacks": "tsx scripts/test_prompt13_callbacks.ts",
    "test:discord": "tsx scripts/test_prompt14_discord.ts",
    "test:embeds": "tsx scripts/test_prompt15_embeds.ts",
    "test:server": "tsx scripts/test_prompt16_server.ts",
    "register:discord": "tsx scripts/register_discord_commands.ts",
    "build:webapp": "npm --prefix webapp run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@libsql/client": "^0.18.0",
    "@solana/spl-token": "^0.1.8",
    "@solana/web3.js": "^3.0.0",
    "@supabase/server": "^1.9.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "telegraf": "^4.16.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
