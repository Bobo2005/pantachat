# ==============================================================================
# PantaChat Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Master Environment Toggle: "staging" (Test/Sandbox) or "production" (Live Mainnet)
# Automatically configures API base URL, Solana RPC, cluster, USDC mint, and explorer links
# ------------------------------------------------------------------------------
PANTA_ENV=staging

# ------------------------------------------------------------------------------
# Panta API Key
# ------------------------------------------------------------------------------
# Staging/Test Mode: Use any test key (pk_test_...) to activate built-in sandbox fixtures
# Production Mode: Use your live key (pk_live_...) for mainnet transactions
PANTA_API_KEY=pk_test_your_panta_api_key_here

# ------------------------------------------------------------------------------
# Optional Overrides (defaults automatically derived from PANTA_ENV)
# ------------------------------------------------------------------------------
# PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_NETWORK=devnet

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_telegram_bot_username

# ------------------------------------------------------------------------------
# Discord Bot Configuration
# ------------------------------------------------------------------------------
# Obtain from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# ------------------------------------------------------------------------------
# AI Provider (Claude / Anthropic)
# ------------------------------------------------------------------------------
# Anthropic API Key and Model for market drafting (defaults to Claude Sonnet 5.5)
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# ------------------------------------------------------------------------------
# Server & Web Companion Configuration
# ------------------------------------------------------------------------------
PORT=3001
WEBAPP_URL=https://pantachat.market

# ------------------------------------------------------------------------------
# Database Configuration (Drizzle ORM + SQLite)
# ------------------------------------------------------------------------------
DATABASE_URL=file:./pantachat.db
